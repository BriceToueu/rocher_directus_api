# HOST="0.0.0.0"
# PORT=8055
# PUBLIC_URL="http://localhost:8055"

# DB_CLIENT="pg"
# DB_HOST=""
# DB_PORT=5432
# DB_DATABASE="postgres"
# DB_USER=""
# DB_PASSWORD=""
# DB_SSL__REJECT_UNAUTHORIZED=false

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SECRET=""

# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""

# CORS_ENABLED=true
# CORS_ORIGIN="http://localhost:3000"

# STORAGE_LOCATIONS="local"
# STORAGE_LOCAL_ROOT="./uploads"

# TELEMETRY=false
# LOG_LEVEL="info"

# Licence Directus (clé fournie par Directus)
LICENSE_KEY=""

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
PASSWORD_RESET_URL_ALLOW_LIST="http://localhost:3000/reinitialiser-mot-de-passe,http://localhost:3000/administration-gocleus/reinitialiser-mot-de-passe,http://localhost:3000/en/reinitialiser-mot-de-passe"
USER_REGISTER_URL_ALLOW_LIST="http://localhost:3000/verifier-email,http://localhost:3000/en/verifier-email"
USER_INVITE_URL_ALLOW_LIST="http://localhost:3000/administration-gocleus/invitation,http://localhost:3000/invitation,http://localhost:3000/en/invitation"
RATE_LIMITER_REGISTRATION_ENABLED=true
RATE_LIMITER_REGISTRATION_POINTS=5
RATE_LIMITER_REGISTRATION_DURATION=3600

EMAIL_FROM="no-reply@votre-domaine.com"
EMAIL_TRANSPORT="smtp"
EMAIL_SMTP_HOST=""   # ex. smtp.gmail.com (port 465, EMAIL_SMTP_SECURE=true, mot de passe d’application Google)
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_SMTP_SECURE=false

# Adresse du serveur Nuxt qui relaie les requêtes (loopback en local)
IP_TRUST_PROXY="loopback"

EMAIL_TEMPLATES_PATH="./templates"

DB_POOL__MIN=0
DB_POOL__MAX=10
DB_POOL__IDLE_TIMEOUT_MILLIS=20000
DB_KEEP_ALIVE=true

# G-immo : fournisseur SMS / WhatsApp (simulation = journalisé, aucun envoi réel ; autres fournisseurs à configurer)
GIMMO_SMS_PROVIDER="simulation"

# URL du site Nuxt (liens envoyés par e-mail aux parties d’un séquestre)
GIMMO_SITE_URL="http://localhost:3000"

# --- Paiement en ligne des abonnements -------------------------------------------------------------------------------
# PAIEMENT_FOURNISSEUR : simulation (aucun paiement réel, page de test) | geniuspay | cinetpay | paydunya
# Pour passer au réel : renseigner les identifiants du fournisseur ci-dessous, mettre PAIEMENT_FOURNISSEUR=geniuspay,
# PAIEMENT_SANDBOX=false (true = compte de test du fournisseur), puis redémarrer Directus.
# Adresse de notification à déclarer chez le fournisseur : <adresse du site>/api/paiement/notification/<fournisseur>
#   (ex. https://votre-domaine.com/api/paiement/notification/geniuspay) — le site doit être accessible depuis Internet.
PAIEMENT_FOURNISSEUR=simulation
PAIEMENT_SANDBOX=true

# GeniusPay (tableau de bord GeniusPay > Paramètres > API) — clés pk_… / sk_… et secret webhook whsec_…
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
# Facultatif : URL de l'API si GeniusPay en communique une autre
GENIUSPAY_BASE_URL=

# CinetPay (nouvelle API) — clé et mot de passe API ; par pays si différents : CINETPAY_API_KEY_CI, CINETPAY_API_PASSWORD_SN…
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=

# PayDunya (tableau de bord PayDunya > Intégration API)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
