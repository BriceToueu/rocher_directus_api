{% layout "base" %} {% block content %}

<h1>Confirm your email address</h1>

<p style="padding-bottom: 30px">
  Welcome to <i>{{ projectName }}</i>!<br /><br />
  To activate your account and start saving your favourite properties,
  confirm your email address by clicking the button below.
</p>

<a
  class="button"
  rel="noopener"
  target="_blank"
  href="{{url}}"
  style="
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    display: inline-block;
    padding: 11px 24px;
    border-radius: 8px;
    background: #004E9B;
    border: 1px solid #ffffff;
  "
>
  <!--[if mso]>
    <i style="letter-spacing: 25px; mso-font-width: -100%; mso-text-raise: 30pt">&nbsp;</i>
  <![endif]-->
  <span style="mso-text-raise: 15pt">Confirm my address</span>
  <!--[if mso]>
    <i style="letter-spacing: 25px; mso-font-width: -100%">&nbsp;</i>
  <![endif]-->
</a>

<p style="padding-top: 30px">
  If you did not create an account on {{ projectName }}, simply ignore this email.
</p>

{% endblock %}
