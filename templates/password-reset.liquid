{% layout "base" %} {% block content %}

<h1>Réinitialisation de votre mot de passe</h1>

<p style="padding-bottom: 30px">
  Bonjour,<br /><br />
  Nous avons reçu une demande de réinitialisation du mot de passe de votre compte
  <i>{{ projectName }}</i>. Pour choisir un nouveau mot de passe, cliquez sur le bouton ci-dessous.
</p>

<a
  class="button"
  rel="noopener"
  target="_blank"
  href="{{url}}"
  style="
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    display: inline-block;
    padding: 11px 24px;
    border-radius: 8px;
    background: #004E9B;
    border: 1px solid #ffffff;
  "
>
  <!--[if mso]>
    <i style="letter-spacing: 25px; mso-font-width: -100%; mso-text-raise: 30pt">&nbsp;</i>
  <![endif]-->
  <span style="mso-text-raise: 15pt">Choisir un nouveau mot de passe</span>
  <!--[if mso]>
    <i style="letter-spacing: 25px; mso-font-width: -100%">&nbsp;</i>
  <![endif]-->
</a>

<p style="padding-top: 30px">
  Ce lien est valable 24 heures et ne peut être utilisé qu’une seule fois.
</p>
<p>
  Si vous n’êtes pas à l’origine de cette demande, ignorez simplement cet e-mail :
  votre mot de passe actuel reste inchangé.
</p>

{% endblock %}
