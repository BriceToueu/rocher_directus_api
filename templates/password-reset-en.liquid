{% layout "base" %} {% block content %}

<h1>Reset your password</h1>

<p style="padding-bottom: 30px">
  Hello,<br /><br />
  We received a request to reset the password of your
  <i>{{ projectName }}</i> account. To choose a new password, click the button below.
</p>

<a
  class="button"
  rel="noopener"
  target="_blank"
  href="{{url}}"
  style="
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    display: inline-block;
    padding: 11px 24px;
    border-radius: 8px;
    background: #004E9B;
    border: 1px solid #ffffff;
  "
>
  <!--[if mso]>
    <i style="letter-spacing: 25px; mso-font-width: -100%; mso-text-raise: 30pt">&nbsp;</i>
  <![endif]-->
  <span style="mso-text-raise: 15pt">Choose a new password</span>
  <!--[if mso]>
    <i style="letter-spacing: 25px; mso-font-width: -100%">&nbsp;</i>
  <![endif]-->
</a>

<p style="padding-top: 30px">
  This link is valid for 24 hours and can only be used once.
</p>
<p>
  If you did not make this request, simply ignore this email:
  your current password remains unchanged.
</p>

{% endblock %}
