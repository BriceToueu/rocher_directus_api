{% layout "base" %} {% block content %}

{% if sujet %}<h1>{{ sujet }}</h1>{% endif %}

<p style="padding-bottom: 20px; line-height: 1.6">
  {{ corps_html }}
</p>

{% if piece_jointe %}
<p style="padding: 12px 16px; background: #EEF7FB; border-radius: 8px">
  Attachment: <strong>{{ piece_jointe }}</strong>
</p>
{% endif %}

<p style="padding-top: 20px; color: #5B6B7F; font-size: 14px">
  {{ agence }}{% if telephone_agence %} · {{ telephone_agence }}{% endif %}
</p>

{% endblock %}
